# Hosted Jev comes through OpenRouter. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key

# The TypeSafe SDK reads these two. Point it at OpenRouter with the same key,
# or at https://api.typesafe.ai with a key from https://console.typesafe.ai/keys
TYPESAFE_BASE_URL=https://openrouter.ai/api
TYPESAFE_API_KEY=sk-or-v1-your-key
